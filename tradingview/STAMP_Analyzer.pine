//@version=6
indicator("STAMP Research Signals (experimental)", overlay=true, max_labels_count=200)
// Use the SAME exchange/symbol and timeframe as the Python dataset.
fastLength = input.int(6, "Fast EMA", minval=1)
slowLength = input.int(20, "Slow EMA", minval=2)
rsiLength = input.int(14, "RSI", minval=2)
fast = ta.ema(close, fastLength)
slow = ta.ema(close, slowLength)
rsi = ta.rsi(close, rsiLength)
[macd, signal, hist] = ta.macd(close, 12, 26, 9)
confirmed = barstate.isconfirmed
bull = confirmed and ta.crossover(fast, slow)
bear = confirmed and ta.crossunder(fast, slow)
plot(fast, "EMA fast", color=color.aqua)
plot(slow, "EMA slow", color=color.orange)
plotshape(bull, title="Bullish crossover", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(bear, title="Bearish crossover", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
alertcondition(bull, "STAMP EMA bullish", "STAMP EMA bullish crossover on {{ticker}} {{interval}}")
alertcondition(bear, "STAMP EMA bearish", "STAMP EMA bearish crossover on {{ticker}} {{interval}}")
// Create alert using 'Any alert() function call' to receive structured JSON.
// Never put API tokens, secrets, or private wallet information in this payload.
if confirmed and (bull or bear)
    direction = bull ? "bullish" : "bearish"
    payload = '{"schema":"stamp.tv.signal.v1","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","bar_time_ms":' + str.tostring(time) + ',"close":' + str.tostring(close, format.mintick) + ',"ema_fast":' + str.tostring(fast) + ',"ema_slow":' + str.tostring(slow) + ',"rsi":' + str.tostring(rsi) + ',"macd_hist":' + str.tostring(hist) + ',"signal":"' + direction + '"}'
    alert(payload, alert.freq_once_per_bar_close)
